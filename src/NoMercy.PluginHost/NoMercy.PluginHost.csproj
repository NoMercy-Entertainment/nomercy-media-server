<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NoMercy.PluginHost</AssemblyName>
    <RootNamespace>NoMercy.PluginHost</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="protobuf-net.Grpc.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\NoMercy.Plugins\Storage\PluginDatabase.cs" Link="Storage\PluginDatabase.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NoMercy.PluginSdk.Ipc\NoMercy.PluginSdk.Ipc.csproj" />
    <ProjectReference Include="..\NoMercy.PluginSdk.Abstractions\NoMercy.PluginSdk.Abstractions.csproj" />
    <ProjectReference Include="..\NoMercy.NmSystem\NoMercy.NmSystem.csproj" />
  </ItemGroup>
</Project>
