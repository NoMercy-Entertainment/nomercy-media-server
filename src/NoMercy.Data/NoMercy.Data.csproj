<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishWithAspNetCoreTargetManifest>false</PublishWithAspNetCoreTargetManifest>
  </PropertyGroup>
  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NoMercy.Tests.Repositories" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="Visualizers\Bundle\visualizers-bundle.json.gz"
      LogicalName="NoMercy.Data.Visualizers.Bundle.visualizers-bundle.json.gz"
    />
    <EmbeddedResource
      Include="Visualizers\Bundle\bundle-hash.txt"
      LogicalName="NoMercy.Data.Visualizers.Bundle.bundle-hash.txt"
    />
    <EmbeddedResource
      Include="Visualizers\Bundle\textures\*.jpg"
      LogicalName="NoMercy.Data.Visualizers.Bundle.textures.%(Filename)%(Extension)"
    />
    <EmbeddedResource
      Include="Visualizers\Bundle\previews\*.webp"
      LogicalName="NoMercy.Data.Visualizers.Bundle.previews.%(Filename)%(Extension)"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoMercy.Events\NoMercy.Events.csproj" />
    <ProjectReference Include="..\NoMercy.NmSystem\NoMercy.NmSystem.csproj" />
    <ProjectReference Include="..\NoMercy.Database\NoMercy.Database.csproj" />
    <ProjectReference Include="..\NoMercy.Monitoring\NoMercy.Monitoring.csproj" />
    <ProjectReference Include="..\NoMercy.MediaProcessing\NoMercy.MediaProcessing.csproj" />
    <ProjectReference Include="..\NoMercy.Notifications\NoMercy.Notifications.csproj" />
    <ProjectReference Include="..\NoMercy.Providers\NoMercy.Providers.csproj" />
    <ProjectReference Include="..\NoMercyQueue\NoMercyQueue.csproj" />
    <ProjectReference Include="..\NoMercy.Storage\NoMercy.Storage.csproj" />
    <ProjectReference Include="..\NoMercy.PluginSdk.Abstractions\NoMercy.PluginSdk.Abstractions.csproj" />
    <ProjectReference Include="..\NoMercy.Plugins\NoMercy.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
</Project>
