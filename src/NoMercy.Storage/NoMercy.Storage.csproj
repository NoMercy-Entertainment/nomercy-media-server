<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NoMercy.Storage</RootNamespace>
    <AssemblyName>NoMercy.Storage</AssemblyName>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NoMercy.Tests.Storage" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="WebDav.Client" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Ulid" />
  </ItemGroup>

  <!-- SMBLibrary: NoMercy fork built by packages/nomercy-smblibrary/scripts/build.ps1. -->
  <!-- Pure managed (netstandard2.0), so one DLL pair runs on every target runtime.    -->
  <!-- The fork adds a public Connect(addr, transport, port) overload; stock SMBLibrary -->
  <!-- hardcodes port 445 so it cannot reach an SMB server on any other port.           -->
  <!-- A fresh fork build in the monorepo wins when present; the vendored copy in       -->
  <!-- libs/smb keeps CI and standalone clones of this repo building without it.        -->
  <PropertyGroup>
    <SmbForkDir>$(MSBuildThisFileDirectory)../../../../packages/nomercy-smblibrary/output/managed</SmbForkDir>
    <SmbForkDir Condition="!Exists('$(SmbForkDir)/NoMercy.SMBLibrary.dll')">$(MSBuildThisFileDirectory)../../libs/smb</SmbForkDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="NoMercy.SMBLibrary">
      <HintPath>$(SmbForkDir)/NoMercy.SMBLibrary.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="NoMercy.SMBLibrary.Utilities">
      <HintPath>$(SmbForkDir)/NoMercy.SMBLibrary.Utilities.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- libnfs native binaries — vendored into libs/nfs (checksums in                -->
  <!-- libs/nfs/CHECKSUMS.txt), updated by a deliberate commit from a               -->
  <!-- nomercy-libnfs build. The server never reads a sibling packages/ folder, so  -->
  <!-- every build — including a standalone clone and its release CI — ships the   -->
  <!-- same binaries. A missing binary fails the build. (July 2026: a guarded copy -->
  <!-- shipped a release without nfs.dll.)                                         -->
  <!-- On Windows, P/Invoke `[DllImport("nfs")]` looks for "nfs.dll" exactly       -->
  <!-- (no lib prefix). Linux/macOS auto-prepend "lib" so libnfs.{so,dylib} works.   -->
  <PropertyGroup>
    <LibNfsDir>$(MSBuildThisFileDirectory)../../libs/nfs</LibNfsDir>
  </PropertyGroup>
  <ItemGroup>
    <None
      Include="$(LibNfsDir)/win-x64/libnfs.dll"
      Link="runtimes/win-x64/native/nfs.dll"
    >
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None
      Include="$(LibNfsDir)/linux-x64/libnfs.so"
      Link="runtimes/linux-x64/native/libnfs.so"
    >
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None
      Include="$(LibNfsDir)/linux-arm64/libnfs.so"
      Link="runtimes/linux-arm64/native/libnfs.so"
    >
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None
      Include="$(LibNfsDir)/osx-x64/libnfs.dylib"
      Link="runtimes/osx-x64/native/libnfs.dylib"
    >
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None
      Include="$(LibNfsDir)/osx-arm64/libnfs.dylib"
      Link="runtimes/osx-arm64/native/libnfs.dylib"
    >
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
