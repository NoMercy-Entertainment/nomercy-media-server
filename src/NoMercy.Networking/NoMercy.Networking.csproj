<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishWithAspNetCoreTargetManifest>false</PublishWithAspNetCoreTargetManifest>
  </PropertyGroup>
  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Makaretu.Dns" />
    <PackageReference Include="Makaretu.Dns.Multicast" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Mono.Nat" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Sharpcaster" />
    <PackageReference Include="Stun.Net" />
    <PackageReference Include="Ulid" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core Http.Abstractions/Http.Features come from the shared framework.
         The previous machine-specific HintPath into Program Files dangled on any
         other machine and on Linux/CI. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoMercy.Events\NoMercy.Events.csproj" />
    <ProjectReference Include="..\NoMercy.Database\NoMercy.Database.csproj" />
    <ProjectReference Include="..\NoMercy.NmSystem\NoMercy.NmSystem.csproj" />
    <ProjectReference Include="..\NoMercy.Authorization\NoMercy.Authorization.csproj" />
    <ProjectReference Include="..\NoMercy.Storage\NoMercy.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NoMercy.Tests.Networking" />
    <InternalsVisibleTo Include="NoMercy.Tests.Api" />
    <InternalsVisibleTo Include="NoMercy.Tests.Events" />
  </ItemGroup>
</Project>
