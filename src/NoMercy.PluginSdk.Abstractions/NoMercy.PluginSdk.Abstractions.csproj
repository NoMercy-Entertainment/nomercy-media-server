<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>NoMercy Plugin Abstractions</Product>
    <PublishWithAspNetCoreTargetManifest>false</PublishWithAspNetCoreTargetManifest>
    <Platforms>AnyCPU;x64;x86;ARM32</Platforms>
  </PropertyGroup>
  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <!--
    Packable because a plugin author outside this repository has no other way to
    get it. The sample plugins reference the project directly, which works only
    because they live here; a third-party plugin has been reduced to copying a
    DLL out of a build, so every contract added to this assembly is invisible to
    its author until someone hands them a file.

    NoMercy.Events travels with it: PluginMessageEvent is the envelope a plugin
    publishes through, and both assemblies are in the shared-assembly set for
    exactly that reason.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>NoMercy.PluginSdk.Abstractions</PackageId>
    <Version>$(PluginPackageVersion)</Version>
    <Authors>NoMercy Entertainment</Authors>
    <Description>The contract a NoMercy MediaServer plugin is written against.</Description>
    <!-- Not PackageLicenseExpression: NuGet only accepts SPDX identifiers it
         knows, and this licence is not one of them. The file travels instead. -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/NoMercy-Entertainment/nomercy-media-server</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/NoMercy-Entertainment/nomercy-media-server</PackageProjectUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!--
      A plugin's identity is an id this platform issues, so it is a Ulid like
      every other id we control. It has to be in the shared-assembly set for the
      same reason Newtonsoft is: a plugin comparing its own Ulid against the
      host's would otherwise be comparing two types that merely look alike.
    -->
    <PackageReference Include="Ulid" />
    <!-- Carried for NoMercy.Design, which ships inside this package. -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <!--
    NoMercy.Events and NoMercy.Design ship inside this package rather than
    beside it. A plugin author installs one thing, not three that have to be
    kept on the same version by hand; nothing else ever referenced them alone.

    The assemblies are copied in, not merged, so their identity does not
    change. Moving a type between assemblies breaks every plugin already
    compiled against it, and this must not.
  -->
  <Target Name="PackTheAssembliesThatTravelWithTheContract" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None
        Include="$(OutputPath)NoMercy.Events.dll;$(OutputPath)NoMercy.Design.dll"
        Pack="true"
        PackagePath="lib/$(TargetFramework)"
        Visible="false"
      />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\NoMercy.Events\NoMercy.Events.csproj" PrivateAssets="all" />
    <!--
      The design system, so a plugin can name any of the fifty-six components
      rather than the ten this assembly had tags for. It carries Newtonsoft,
      which the plugin load context already shares: a plugin's [JsonProperty]
      has to resolve to the host's copy or the host's formatter ignores it.
    -->
    <ProjectReference Include="..\NoMercy.Design\NoMercy.Design.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
