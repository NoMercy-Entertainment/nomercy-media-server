<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishWithAspNetCoreTargetManifest>false</PublishWithAspNetCoreTargetManifest>
      <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NoMercy.Tests.Events" />
    <InternalsVisibleTo Include="NoMercy.Tests.Api" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="MimeMapping" />
    <PackageReference Include="Newtonsoft.Json" />

    <PackageReference Include="Ulid" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoMercy.Data\NoMercy.Data.csproj" />
    <ProjectReference Include="..\NoMercy.Encoder\NoMercy.Encoder.csproj" />
    <ProjectReference Include="..\NoMercy.Monitoring\NoMercy.Monitoring.csproj" />
    <ProjectReference Include="..\NoMercy.OpticalMedia\NoMercy.OpticalMedia.csproj" />
    <ProjectReference Include="..\NoMercy.Events\NoMercy.Events.csproj" />
    <ProjectReference Include="..\NoMercy.Design\NoMercy.Design.csproj" />
    <ProjectReference Include="..\NoMercy.PluginSdk.Abstractions\NoMercy.PluginSdk.Abstractions.csproj" />
    <!--
      The host has to load this one for a plugin's controller base to keep a
      single type identity across the load-context boundary. It is in the
      shared-assembly set; nothing shares an assembly the host never loaded.
    -->
    <ProjectReference Include="..\NoMercy.PluginSdk.Mvc\NoMercy.PluginSdk.Mvc.csproj" />
    <ProjectReference Include="..\NoMercy.Networking\NoMercy.Networking.csproj" />
    <ProjectReference Include="..\NoMercy.Setup\NoMercy.Setup.csproj" />
    <ProjectReference Include="..\NoMercy.NmSystem\NoMercy.NmSystem.csproj" />
    <ProjectReference Include="..\NoMercy.Authorization\NoMercy.Authorization.csproj" />
    <ProjectReference Include="..\NoMercy.Providers\NoMercy.Providers.csproj" />
    <ProjectReference Include="..\NoMercy.Queue.MediaServer\NoMercy.Queue.MediaServer.csproj" />
    <ProjectReference Include="..\NoMercy.Storage\NoMercy.Storage.csproj" />
    <ProjectReference Include="..\NoMercy.Notifications\NoMercy.Notifications.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\I18N.xml" />
  </ItemGroup>
</Project>
