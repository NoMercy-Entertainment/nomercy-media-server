<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\icons\icon.ico</ApplicationIcon>
    <Description>The Effortless Encoder</Description>
    <PackageIcon>Assets\icon.png</PackageIcon>
    <Product>NoMercy MediaServer</Product>
    <BuildFrameworkVersion>6.0.2</BuildFrameworkVersion>
    <PublishWithAspNetCoreTargetManifest>false</PublishWithAspNetCoreTargetManifest>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PackageTags>streaming media content-management private streaming-video streaming-audio
            blurayrip video-encoder</PackageTags>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Suppress NU1701 for MediaBrowser.Model.Signed which targets older .NET Framework but is
        required by the project -->
    <NoWarn>$(NoWarn);NU1701;NETSDK1206</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NoMercy.Tests.Setup" />
    <InternalsVisibleTo Include="NoMercy.Tests.Api" />
    <InternalsVisibleTo Include="NoMercy.Tests.Service" />
  </ItemGroup>
  <PropertyGroup>
    <TargetName>NoMercyMediaServer</TargetName>
    <AssemblyName>NoMercyMediaServer</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Embed portable symbols into the single-file binary so remote exception
         traces from self-hosted users carry file and line numbers. Embedded avoids
         shipping a separate .pdb next to the single-file exe. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="AspNetCore.SwaggerUI.Themes" />
    <PackageReference Include="CommandLineParser" />
    <PackageReference Include="H.NotifyIcon" />
    <PackageReference Include="I18N.DotNet" />
    <PackageReference Include="MediaBrowser.Model.Signed" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />

    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.NewtonsoftJson" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="MimeMapping" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" />
    <PackageReference Include="Swashbuckle.AspNetCore.Newtonsoft" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />

    <PackageReference Include="Ulid" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AniDB">
      <HintPath>..\NoMercy.Providers\AniDb\core\AniDB.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoMercy.Api\NoMercy.Api.csproj" />
    <ProjectReference Include="..\NoMercy.Database\NoMercy.Database.csproj" />
    <ProjectReference Include="..\NoMercy.Authorization\NoMercy.Authorization.csproj" />
    <ProjectReference Include="..\NoMercy.Data\NoMercy.Data.csproj" />
    <ProjectReference Include="..\NoMercy.Encoder\NoMercy.Encoder.csproj" />
    <ProjectReference Include="..\NoMercy.Monitoring\NoMercy.Monitoring.csproj" />
    <ProjectReference Include="..\NoMercy.MediaProcessing\NoMercy.MediaProcessing.csproj" />
    <ProjectReference Include="..\NoMercy.OpticalMedia\NoMercy.OpticalMedia.csproj" />
    <ProjectReference Include="..\NoMercy.Events\NoMercy.Events.csproj" />
    <ProjectReference Include="..\NoMercy.Plugins\NoMercy.Plugins.csproj" />
    <!--
      The host that runs a plugin in a process of its own. Referenced for build
      order only: nothing here links against it, because the server starts it
      as a program by path.

      ReferenceOutputAssembly=false keeps its assembly off this one's compile
      references. Without it both processes would carry the plugin contract,
      and which copy loaded would depend on which came first.
    -->
    <ProjectReference
      Include="..\NoMercy.PluginHost\NoMercy.PluginHost.csproj"
      ReferenceOutputAssembly="false"
      Private="false"
    />
    <ProjectReference Include="..\NoMercy.Networking\NoMercy.Networking.csproj" />
    <ProjectReference Include="..\NoMercy.Providers\NoMercy.Providers.csproj" />
    <ProjectReference Include="..\NoMercy.Queue.MediaServer\NoMercy.Queue.MediaServer.csproj" />
    <ProjectReference Include="..\NoMercy.NmSystem\NoMercy.NmSystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\icons\*.*" Link="Assets\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\linux\*.*" Link="Assets\Linux\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\macos\*.*" Link="Assets\MacOS\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="Never" />
    <None Update="appsettings.Development.json" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <PropertyGroup>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <!--
    The plugin host is a program, not a library, so it needs its apphost, its
    deps.json and its runtimeconfig.json beside it. A ProjectReference carries
    only the assembly, and the server would find a NoMercy.PluginHost.dll it
    could not start.
  -->
  <Target Name="CopyThePluginHostBesideTheServer" AfterTargets="Build">
    <ItemGroup>
      <PluginHostOutput
        Include="$(MSBuildThisFileDirectory)..\NoMercy.PluginHost\bin\$(Configuration)\$(TargetFramework)\**\*"
        Exclude="$(MSBuildThisFileDirectory)..\NoMercy.PluginHost\bin\$(Configuration)\$(TargetFramework)\**\*.pdb"
      />
    </ItemGroup>
    <Copy
      SourceFiles="@(PluginHostOutput)"
      DestinationFiles="@(PluginHostOutput->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Condition="'@(PluginHostOutput)' != ''"
    />
  </Target>
</Project>
