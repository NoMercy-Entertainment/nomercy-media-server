<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Suppress NETSDK1206: MediaInfo.Core.Native uses version-specific RIDs (third-party, not fixable) -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
    <!-- Zero warnings, enforced: any warning is a build failure so none can creep back in. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>NoMercy Entertainment</Authors>
    <Company>NoMercy Entertainment</Company>
    <Copyright>2026 NoMercy Entertainment</Copyright>
    <PackageProjectUrl>https://nomercy.tv</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NoMercy-Entertainment/nomercy-media-server</RepositoryUrl>

    <Version>0.1.517</Version>

    <!--
      The plugin packages version with the contract, not with the server. A
      plugin's manifest names a targetAbi and the template asks for that major,
      so a package version that tracked the server would resolve to something
      no manifest claims compatibility with.

      This is the same number as PluginAbi.Current and a test holds the two
      together, because written twice they drift and the half that drifts is
      whichever one nobody is looking at.
    -->
    <PluginPackageVersion>11.0.0</PluginPackageVersion>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
  </PropertyGroup>

  <!--
      Ship NoMercy.Analyzers (all custom analyzers + code fix providers: named
      arguments, callback parameter naming, storage path rules) to every project
      as a companion, the standard "analyzer-as-companion" ProjectReference
      pattern (OutputItemType="Analyzer" + ReferenceOutputAssembly="false"). This
      file is inherited by every project under the repo — including the
      analyzer's own project — so a PackageReference here was circular: the
      analyzer would need to consume its own not-yet-built package to build
      itself. The condition excludes the analyzer project from referencing itself.
    -->
  <ItemGroup>
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)src\NoMercy.Analyzers\NoMercy.Analyzers.csproj"
      Condition="'$(MSBuildProjectName)' != 'NoMercy.Analyzers' and '$(MSBuildProjectName)' != 'NoMercy.Tests.Analyzers'"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
