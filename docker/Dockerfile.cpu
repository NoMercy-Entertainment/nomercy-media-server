# NoMercy MediaServer - Runtime Only (CPU)
# Used by CI with pre-built self-contained binary in ./publish/

FROM debian:bookworm-slim
WORKDIR /app

# WITH_BROWSER=true adds Xvfb and the libraries Chrome needs, for plugins that
# drive a real browser (#597). CI publishes the CPU image built this way as the
# -browser tags; the default images leave it out to stay small.
ARG WITH_BROWSER=false

# Install minimal dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libva2 \
    libva-drm2 \
    libdrm2 \
    libicu72 \
    libssl3 \
    mediainfo \
    curl \
    ca-certificates \
    pciutils \
    procps \
    sqlite3 \
    htop \
    # --- Browser runtime for plugins (#597) ---------------------------------
    # Only with WITH_BROWSER=true (the -browser image). Plugins that solve web
    # challenges download Chrome for Testing themselves and run it on an Xvfb
    # display (headless Chrome fails those challenges). The libraries are
    # Chrome's deb.deps list without wget, xdg-utils, libcurl and
    # ca-certificates, which Chrome for Testing does not load (its root
    # certificates are built in).
    && if [ "$WITH_BROWSER" = "true" ]; then \
        apt-get install -y --no-install-recommends \
        xvfb \
        xauth \
        fonts-liberation \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libatspi2.0-0 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libexpat1 \
        libgbm1 \
        libglib2.0-0 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libudev1 \
        libvulkan1 \
        libx11-6 \
        libxcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2; \
    fi \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -o -u 1000 nomercy

# Create data directories (app stores data under $HOME/.local/share/NoMercy/)
RUN mkdir -p /data/.local/share/NoMercy \
    && chown -R nomercy:nomercy /data

# Copy self-contained binary
COPY publish/NoMercyMediaServer .
RUN chown -R nomercy:nomercy /app

# Start as root only so the entrypoint can hand an old root-owned volume to
# nomercy; it then drops to nomercy before the server starts.
COPY docker/entrypoint.sh /usr/local/bin/nomercy-entrypoint.sh
RUN chmod +x /usr/local/bin/nomercy-entrypoint.sh

ENV ASPNETCORE_ENVIRONMENT=Production
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV HOME=/data

EXPOSE 7626

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fsk https://127.0.0.1:7626/health || curl -fs http://127.0.0.1:7626/health || exit 1

ENTRYPOINT ["/usr/local/bin/nomercy-entrypoint.sh", "./NoMercyMediaServer"]
CMD ["--internal-port", "7626"]
