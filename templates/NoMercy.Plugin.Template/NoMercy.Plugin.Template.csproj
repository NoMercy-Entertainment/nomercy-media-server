<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The major is pinned and the minor floats. A bare * rebuilds a plugin
      against a contract it was never tested with, and the first sign of that
      is a server refusing to load it. Pinning the minor too is the opposite
      mistake: the contract adds members in a minor, so every additive change
      would make every plugin in the world re-pin before it could restore.
    -->
    <PackageReference Include="NoMercy.PluginSdk.Abstractions" Version="12.*" />
    <PackageReference Include="NoMercy.PluginSdk.Mvc" Version="12.*" />
    <PackageReference Include="NoMercy.PluginSdk.Analyzers" Version="12.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json;settings.schema.json;lang\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
