<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!-- Use default.runsettings to serialize test assembly execution (prevents SQLite contention) -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)default.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared test environment setup — routes paths to NoMercy_test, cleans before run -->
    <Compile
      Include="$(MSBuildThisFileDirectory)TestEnvironmentSetup.cs"
      Link="TestEnvironmentSetup.cs"
      Condition="'$(MSBuildProjectName)' != 'NoMercy.Tests.Common'"
    />
    <!-- Serialize xUnit collections in every test assembly (not the plugin sample). -->
    <Compile
      Include="$(MSBuildThisFileDirectory)SharedTestParallelization.cs"
      Link="SharedTestParallelization.cs"
      Condition="'$(MSBuildProjectName)' != 'NoMercy.Plugin.Samples.Echo' AND '$(MSBuildProjectName)' != 'NoMercy.Plugin.Samples.EchoNext' AND '$(MSBuildProjectName)' != 'NoMercy.Tests.Common'"
    />
  </ItemGroup>
  <ItemGroup>
    <!-- TestEnvironmentSetup.cs needs NmSystem for Config.IsTest and AppFiles.AppPath -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\NoMercy.NmSystem\NoMercy.NmSystem.csproj" />
  </ItemGroup>
</Project>
