<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Moq" />
    <!--
      So the wire assertions can serialize the way the API does. They used
      System.Text.Json, which writes no response in this server, and passed
      while the real payload carried a second copy of every child under a key
      no client reads.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NoMercy.Plugins.Abstractions\NoMercy.Plugins.Abstractions.csproj" />
    <ProjectReference Include="..\NoMercy.Tests.Common\NoMercy.Tests.Common.csproj" />
    <ProjectReference Include="..\..\src\NoMercy.Plugins\NoMercy.Plugins.csproj" />
    <ProjectReference Include="..\..\src\NoMercy.Events\NoMercy.Events.csproj" />
    <ProjectReference Include="..\..\src\NoMercy.Storage\NoMercy.Storage.csproj" />
    <!-- Build dependency only — do NOT copy Echo/Failures DLLs to test bin. If they were in
         the default AssemblyLoadContext, PluginLoadContext isolation would break (type
         identity mismatch). -->
    <ProjectReference
      Include="..\NoMercy.Plugin.Samples.Echo\NoMercy.Plugin.Samples.Echo.csproj"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference
      Include="..\NoMercy.Plugin.Samples.EchoNext\NoMercy.Plugin.Samples.EchoNext.csproj"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference
      Include="..\NoMercy.Plugin.Samples.Failures\NoMercy.Plugin.Samples.Failures.csproj"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference
      Include="..\NoMercy.Plugin.Samples.ManifestFailure\NoMercy.Plugin.Samples.ManifestFailure.csproj"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
